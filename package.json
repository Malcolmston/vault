{
  "name": "@mstone6969/vault",
  "version": "2.3.0",
  "description": "A write-only credential vault: envelope encryption, key rotation, expiry, history and an encrypted single-file store.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Malcolmston/vault.git"
  },
  "homepage": "https://github.com/Malcolmston/vault#readme",
  "bugs": {
    "url": "https://github.com/Malcolmston/vault/issues"
  },
  "author": "Malcolmston",
  "keywords": [
    "vault",
    "secrets",
    "credentials",
    "encryption",
    "aes-gcm",
    "bun"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./stores/memory": {
      "types": "./dist/stores/memory.d.ts",
      "import": "./dist/stores/memory.js",
      "require": "./dist/stores/memory.cjs"
    },
    "./stores/file": {
      "types": "./dist/stores/file.d.ts",
      "import": "./dist/stores/file.js",
      "require": "./dist/stores/file.cjs"
    },
    "./stores/sqlite": {
      "types": "./dist/stores/sqlite.d.ts",
      "import": "./dist/stores/sqlite.js"
    },
    "./stores/postgres": {
      "types": "./dist/stores/postgres.d.ts",
      "import": "./dist/stores/postgres.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "MIGRATING.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run docs:check && bun run test:coverage && bun run build && bun run docs",
    "test:coverage": "bun run scripts/coverage.ts",
    "docs": "typedoc",
    "docs:check": "typedoc --emit none"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
